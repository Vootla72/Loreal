generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per product + wording, so re-assessing the same claim adds to its history.
model Claim {
  id             Int          @id @default(autoincrement())
  productName    String
  claimText      String
  normalizedText String /// Trimmed, lowercased, single-spaced: used to match the same claim
  createdAt      DateTime     @default(now())
  assessments    Assessment[]

  @@unique([productName, normalizedText])
}

model Assessment {
  id              Int      @id @default(autoincrement())
  claimId         Int
  claim           Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence        String   @db.Text
  isJustified     Boolean
  confidenceScore Float /// 0.0 - 1.0
  reasoning       String   @db.Text
  model           String /// LLM model id, or "mock" when no API key is set
  evidenceHash    String /// sha256 of the whitespace-normalized evidence: the cache key for reusing a verdict
  promptVersion   String   @default("v1")
  createdAt       DateTime @default(now())

  @@index([claimId, createdAt])
  @@index([claimId, evidenceHash, model, promptVersion])
}
