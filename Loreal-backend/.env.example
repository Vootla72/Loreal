# PostgreSQL connection string. Replace YOUR_PASSWORD with your local postgres password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/loreal_claims_core?schema=public"

# OpenAI. Leave OPENAI_API_KEY empty to use the built-in offline mock assessor.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

PORT=3000
CORS_ORIGIN="http://localhost:5173"
